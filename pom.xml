<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.izikstar</groupId>
    <artifactId>izikstar-chess</artifactId>
    <version>3.1.0</version>
    <packaging>jar</packaging>
    <name>IzikStar Chess</name>
    <description>Swing chess game with a bitboard alpha-beta engine and a Stockfish UCI bridge.</description>

    <properties>
        <maven.compiler.release>26</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Main class, referenced by the shade plugin and exec plugin. -->
        <main.class>main.Main</main.class>

        <!-- Surefire test selection. Defaults run the "do not regress" suite and skip
             the known-bug tests; the `known-bugs` profile flips these. -->
        <surefire.groups></surefire.groups>
        <surefire.excludedGroups>known-bug</surefire.excludedGroups>
        <surefire.testFailureIgnore>false</surefire.testFailureIgnore>

        <!-- Dependency versions: pinned to match the jars previously checked into libs/
             (see docs/phase-0-notes.md for the one deliberate deviation: okio). -->
        <retrofit.version>2.9.0</retrofit.version>
        <gson.version>2.8.9</gson.version>
        <okhttp.version>4.9.3</okhttp.version>
        <kotlin.version>1.8.0</kotlin.version>
        <flatlaf.version>3.0</flatlaf.version>
        <junit.version>5.10.2</junit.version>
    </properties>

    <dependencies>
        <!-- ai/openingBook: Retrofit + OkHttp + Gson client for the Lichess API.
             Currently never invoked at runtime; kept so the package keeps compiling.
             okio is intentionally NOT pinned here - it resolves transitively from
             okhttp 4.9.3 (okio 2.8.0). The libs/okio-3.2.0.jar that used to be on
             the classpath is a 25 KB stub incompatible with this okhttp; see notes. -->
        <dependency>
            <groupId>com.squareup.retrofit2</groupId>
            <artifactId>retrofit</artifactId>
            <version>${retrofit.version}</version>
        </dependency>
        <dependency>
            <groupId>com.squareup.retrofit2</groupId>
            <artifactId>converter-gson</artifactId>
            <version>${retrofit.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>${okhttp.version}</version>
        </dependency>
        <!-- Was checked in explicitly under libs/; okhttp pulls a matching version
             transitively, but pin it so the migration doesn't silently drop it. -->
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>${kotlin.version}</version>
        </dependency>

        <!-- Swing look and feel; was .idea/flatlaf-3.0.jar. -->
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf</artifactId>
            <version>${flatlaf.version}</version>
        </dependency>

        <!-- Characterization test suite (Phase 0). -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>izikstar-chess-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <!-- Headless so board/piece construction never needs a display. -->
                    <argLine>-Djava.awt.headless=true</argLine>
                    <!-- Mirror how the app actually runs: assertions OFF. Surefire turns
                         them on by default, which trips a stray `assert` in
                         BoardState.sameTeam() that the next line already handles. -->
                    <enableAssertions>false</enableAssertions>
                    <!-- Driven by properties so the `known-bugs` profile can flip them
                         without a fragile config merge (see docs/phase-0-notes.md). -->
                    <groups>${surefire.groups}</groups>
                    <excludedGroups>${surefire.excludedGroups}</excludedGroups>
                    <testFailureIgnore>${surefire.testFailureIgnore}</testFailureIgnore>
                </configuration>
            </plugin>

            <!-- Runnable fat jar, replacing the hand-built out/artifacts/chessGame_3.jar. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Convenience: mvn exec:java -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- mvn test -Pknown-bugs
             Runs ONLY the tests tagged "known-bug". These assert the CORRECT chess
             behavior and are expected to FAIL against the current engine; each one is
             a concrete "is this fixed yet" signal for a later phase. The build still
             succeeds (testFailureIgnore) - the failure report is the deliverable. -->
        <profile>
            <id>known-bugs</id>
            <properties>
                <surefire.groups>known-bug</surefire.groups>
                <surefire.excludedGroups></surefire.excludedGroups>
                <surefire.testFailureIgnore>true</surefire.testFailureIgnore>
            </properties>
        </profile>
    </profiles>

</project>
