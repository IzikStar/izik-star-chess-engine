<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.izikstar</groupId>
    <artifactId>izikstar-chess</artifactId>
    <version>3.1.0</version>
    <packaging>jar</packaging>
    <name>IzikStar Chess</name>
    <description>Chess and chess variants with a browser UI, an alpha-beta engine, an evolution lab and a Stockfish UCI bridge.</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Main class, referenced by the shade plugin and exec plugin. Since Phase 4c the jar
             starts the web UI. -->
        <main.class>web.WebServer</main.class>

        <!-- The React app in web/ is built into the jar at prepare-package (so `mvn test` needs
             no Node). The build downloads its own Node into target/. -Dskip.web=true skips it. -->
        <node.version>v22.22.0</node.version>
        <skip.web>false</skip.web>

        <!-- Surefire test selection. Defaults skip the slower smoke and stress tests;
             the `smoke` and `stress` profiles flip these. -->
        <surefire.groups></surefire.groups>
        <surefire.excludedGroups>smoke,stress</surefire.excludedGroups>

        <gson.version>2.8.9</gson.version>
        <kotlin.version>1.9.25</kotlin.version>
        <junit.version>5.10.2</junit.version>
        <javalin.version>6.7.0</javalin.version>
        <slf4j.version>2.0.17</slf4j.version>
        <sqlite.version>3.46.1.3</sqlite.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>
        <!-- Javalin 6.7 is built against Kotlin 1.9; pinned so the stdlib version is explicit. -->
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>${kotlin.version}</version>
        </dependency>

        <!-- Web UI server (Phase 4c): HTTP for the built React app + one WebSocket for the game. -->
        <dependency>
            <groupId>io.javalin</groupId>
            <artifactId>javalin</artifactId>
            <version>${javalin.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <!-- Evolution runs (Phase 5): one SQLite file per run, nothing to install. -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
        </dependency>

        <!-- Characterization test suite (Phase 0). -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>izikstar-chess-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <!-- Mirror how the app actually runs: assertions OFF. -->
                    <enableAssertions>false</enableAssertions>
                    <!-- Driven by properties so the profiles below can flip them. -->
                    <groups>${surefire.groups}</groups>
                    <excludedGroups>${surefire.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>

            <!-- Web UI (Phase 4c): web/ -> target/classes/webapp, before the jar is shaded. -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>2.0.2</version>
                <configuration>
                    <workingDirectory>web</workingDirectory>
                    <installDirectory>${project.build.directory}</installDirectory>
                    <skip>${skip.web}</skip>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <configuration>
                            <nodeVersion>${node.version}</nodeVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-ci</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>ci --no-audit --no-fund</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-build</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Runnable fat jar, replacing the hand-built out/artifacts/chessGame_3.jar. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Convenience: mvn exec:java -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- mvn test -Psmoke
             Runs ONLY the @Tag("smoke") end-to-end tests (AppSmokeTest): full games through
             the rules API and the search board. These MUST pass. -->
        <profile>
            <id>smoke</id>
            <properties>
                <surefire.groups>smoke</surefire.groups>
                <surefire.excludedGroups>stress</surefire.excludedGroups>
            </properties>
        </profile>

        <!-- mvn test -Pstress
             Runs ONLY the @Tag("stress") tests. game.StressTest (Phase 4): many unattended
             engine-vs-engine games (Stockfish ones too when it is installed) and a storm of
             random moves, take-backs and hint requests. The move generator's deep perft and
             its random-games check against Stockfish, and engine.SearchSpeedTest, the Level 6
             and 7 speed benchmark in a 300 MB heap (Phase 4b). Takes several minutes. -->
        <profile>
            <id>stress</id>
            <properties>
                <surefire.groups>stress</surefire.groups>
                <surefire.excludedGroups></surefire.excludedGroups>
            </properties>
        </profile>
    </profiles>

</project>
